# ==============================================================================
# Environment Configuration Template: SK Sutras Four-Agent Authoring Platform
# Author: Hiranyam AI Labs (https://hiranyamai.com/)
# Author and Final Approver: Shri Shripad Kulkarni
# NOTE: Safe placeholders only. NEVER commit real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operational Execution Mode & Safety Gates
# ------------------------------------------------------------------------------
# Set to 'true' during development/testing to enforce 100% offline simulation without API charges.
# Set to 'false' only after explicit written authorization and API key configuration.
OFFLINE_MODE=true

# ------------------------------------------------------------------------------
# 2. Four-Agent AI Model Allocations (Centrally Configurable)
# ------------------------------------------------------------------------------
# Agent 1 — Narada Specialist (Google Gemini)
AGENT1_PROVIDER=google
AGENT1_MODEL_ID=gemini-1.5-pro

# Agent 2 — Shandilya Specialist (OpenAI GPT)
AGENT2_PROVIDER=openai
AGENT2_MODEL_ID=gpt-4o

# Agent 3 — Sutrakar Master Author (Anthropic Claude)
AGENT3_PROVIDER=anthropic
AGENT3_MODEL_ID=claude-3-5-sonnet-20241022

# Agent 4 — Independent Validator (Separately Configurable OpenAI GPT)
AGENT4_PROVIDER=openai
AGENT4_MODEL_ID=gpt-4o

# ------------------------------------------------------------------------------
# 3. Provider API Credentials (To be filled during authorized setup)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_ai_studio_or_vertex_api_key_here
OPENAI_API_KEY=your_openai_commercial_api_key_here
ANTHROPIC_API_KEY=your_anthropic_commercial_api_key_here

# Optional Secondary Account for Agent 4 Independent Validation Isolation
OPENAI_VALIDATOR_API_KEY=your_independent_validator_openai_key_here

# ------------------------------------------------------------------------------
# 4. Central Cost Management, Budget Controls & Token Accounting
# ------------------------------------------------------------------------------
# Project monthly hard spending cap in Indian Rupees (INR)
MONTHLY_PROJECT_BUDGET_INR=50000.00

# Provider-level spending sub-caps in INR
BUDGET_GOOGLE_INR=15000.00
BUDGET_OPENAI_INR=20000.00
BUDGET_ANTHROPIC_INR=20000.00

# USD to INR Exchange Rate for transparent currency conversion
USD_TO_INR_EXCHANGE_RATE=83.50

# Alert Notification Email for budget threshold triggers (50%, 75%, 90%, 100%)
BUDGET_ALERT_EMAIL=notifications@hiranyamai.com

# ------------------------------------------------------------------------------
# 5. Token Efficiency & Caching Controls
# ------------------------------------------------------------------------------
ENABLE_PROMPT_CACHING=true
PROMPT_CACHE_TTL_SECONDS=3600
ENABLE_BATCH_API=false

# ------------------------------------------------------------------------------
# 6. Database Configurations (SQLite for Dev / PostgreSQL for Production)
# ------------------------------------------------------------------------------
# SQLite local development store
SQLITE_DB_PATH=./data/manuscript.db

# Production PostgreSQL Database Credentials (apply only in authorized staging/prod)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sk_sutras_production
POSTGRES_USER=sutras_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ------------------------------------------------------------------------------
# 7. Vector Store & Classical Sutra Ingestion
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
EMBEDDING_MODEL=BAAI/bge-m3

# ------------------------------------------------------------------------------
# 8. Senior Citizen (65+ Mode) Accessibility Presets
# ------------------------------------------------------------------------------
DEFAULT_SENIOR_MODE=true
DEFAULT_FONT_SCALE=large
DEFAULT_HIGH_CONTRAST=true
