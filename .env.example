# ==============================================================================
# Dynamic LLM Provider Configuration (init_chat_model)
# ==============================================================================
# Supported providers: openai, anthropic, google_vertexai, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2

# Provider Credentials
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Local Offline Inference (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# Vector Store & Embedding Configuration
# ==============================================================================
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
EMBEDDING_MODEL=BAAI/bge-m3

# ==============================================================================
# Relational Database Configuration
# ==============================================================================
SQLITE_DB_PATH=./data/manuscript.db

# ==============================================================================
# Accessibility Engine Default Settings
# ==============================================================================
# Default Senior Citizen (65+ Mode) activation
DEFAULT_SENIOR_MODE=true
DEFAULT_FONT_SCALE=large
